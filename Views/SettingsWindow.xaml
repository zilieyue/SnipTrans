<Window x:Class="SnipTrans.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnipTrans 设置"
        Width="540" Height="660"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F7F8FA"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="BorderBrush" Value="#E8EAF0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2B3240"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#4A5464"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#D8DCE5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#4A5464"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 翻译引擎 -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="翻译引擎" Style="{StaticResource SectionTitle}"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="引擎" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="EngineCombo" Grid.Column="1"
                                      SelectionChanged="EngineCombo_SelectionChanged">
                                <ComboBoxItem Content="MyMemory（免费，无需配置）"/>
                                <ComboBoxItem Content="AI 大模型（质量最好，需 API Key）"/>
                            </ComboBox>
                        </Grid>

                        <StackPanel x:Name="OpenAiPanel" Margin="0,4,0,0">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="接口地址" Style="{StaticResource Label}"/>
                                <TextBox x:Name="BaseUrlBox" Grid.Column="1"
                                         ToolTip="OpenAI 兼容的 /v1 地址，如 https://api.deepseek.com/v1"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="API Key" Style="{StaticResource Label}"/>
                                <TextBox x:Name="ApiKeyBox" Grid.Column="1"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="模型" Style="{StaticResource Label}"/>
                                <TextBox x:Name="ModelBox" Grid.Column="1"
                                         ToolTip="如 deepseek-chat / gpt-4o-mini / qwen-turbo"/>
                            </Grid>
                        </StackPanel>

                        <Button x:Name="TestButton" Content="测试翻译引擎"
                                HorizontalAlignment="Left" Margin="0,12,0,0"
                                Click="TestButton_Click"/>
                        <TextBlock x:Name="TestResult" FontSize="11.5" Foreground="#6B7486"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 识别行为 -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="识别与显示" Style="{StaticResource SectionTitle}"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="目标语言" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="TargetLangCombo" Grid.Column="1">
                                <ComboBoxItem Content="中文"/>
                                <ComboBoxItem Content="英文"/>
                            </ComboBox>
                        </Grid>

                        <CheckBox x:Name="AutoSwitchCheck"
                                  Content="原文是中文时自动反向翻译成英文"/>
                        <CheckBox x:Name="ShowOriginalCheck"
                                  Content="在浮窗中显示识别到的原文"/>
                        <CheckBox x:Name="CloseOnDeactivateCheck"
                                  Content="浮窗失去焦点时自动关闭"/>
                        <CheckBox x:Name="SkipDuplicateCheck"
                                  Content="跳过重复的相同截图"/>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="自动关闭" Style="{StaticResource Label}"/>
                            <TextBox x:Name="AutoCloseBox" Grid.Column="1" Width="80"
                                     HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="2" Text="秒后关闭，0 表示不自动关闭"
                                       FontSize="11.5" Foreground="#8A93A3" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="最大图像" Style="{StaticResource Label}"/>
                            <TextBox x:Name="MaxSideBox" Grid.Column="1" Width="80"
                                     HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="2" Text="像素（超过则忽略，防止误处理大图）"
                                       FontSize="11.5" Foreground="#8A93A3" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 使用说明 -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="使用方法" Style="{StaticResource SectionTitle}"/>
                        <TextBlock FontSize="12.5" Foreground="#4A5464" TextWrapping="Wrap" LineHeight="21">
                            <Run Text="1. 正常按 "/>
                            <Run Text="Win + Shift + S" FontWeight="Bold" Foreground="#2563EB"/>
                            <Run Text=" 框选屏幕上任意区域。"/>
                            <LineBreak/>
                            <Run Text="2. 松开鼠标后，译文浮窗会自动出现在光标附近。"/>
                            <LineBreak/>
                            <Run Text="3. 按 Esc 关闭浮窗，双击译文即可复制。"/>
                        </TextBlock>
                        <Button Content="打开配置文件夹" HorizontalAlignment="Left" Margin="0,12,0,0"
                                Click="OpenConfigFolder_Click"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" FontSize="11.5" Foreground="#8A93A3"
                       VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Margin="0,0,8,0" Click="CancelButton_Click"/>
                <Button Content="保存" IsDefault="True" Click="SaveButton_Click"
                        Background="#2563EB" Foreground="White" BorderThickness="0"
                        Padding="20,7"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
